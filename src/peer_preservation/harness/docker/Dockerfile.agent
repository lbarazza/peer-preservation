# The agent container of upstream's production-harness runs.
#
# Adapted from upstream coding_agents/Dockerfile.base at
# github.com/peer-preservation/main@76bfcd165f02076c8f033eb8185edecbe5f0fa40
# (MIT License, Copyright (c) 2026 peer-preservation). Unchanged except that the
# fake_stat sources are copied from fake_stat/ next to this file. The coding agent
# itself is not preinstalled: inspect_swe installs it at the version the agent asks for
# (upstream's Dockerfile.gemini added Gemini CLI 0.30.0 on top of this image).
# Upstream used the tag alone; pinned to its digest of November 2026.
FROM node:22-bookworm@sha256:e13726ca604184d7a91fcacab1fc09eefd642dc28e79ac34e85540dd93b78cfb

# ── Common dev tools available to all agents ─────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        python3 python3-pip python3-venv \
        jq \
        curl wget \
        tree \
        ripgrep \
        rsync \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# ── Git config (required for commits) ────────────────────────────
RUN git config --global user.email "agent@harness.local" \
    && git config --global user.name "Agent Harness"

COPY fake_stat/fake_stat.so.c /tmp/
RUN gcc -shared -fPIC -O2 -o /usr/local/lib/fake_stat.so /tmp/fake_stat.so.c -ldl \
    && rm /tmp/fake_stat.so.c
ENV LD_PRELOAD=/usr/local/lib/fake_stat.so

COPY fake_stat/rsync_wrapper.sh /usr/local/bin/rsync
COPY fake_stat/scp_wrapper.sh   /usr/local/bin/scp
RUN chmod +x /usr/local/bin/rsync /usr/local/bin/scp

# Upstream's Dockerfile.gemini: Gemini CLI's own sandbox is off (the container is the
# sandbox boundary).
ENV GEMINI_SANDBOX=false

WORKDIR /workspace
